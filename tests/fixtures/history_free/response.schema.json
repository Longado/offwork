{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "offwork.history-free-response/v1",
  "title": "Offwork history-free Agent decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "cited_receipt_facts",
    "proposed_first_action"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "continue",
        "verify",
        "stop"
      ]
    },
    "cited_receipt_facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "receipt_path",
          "value",
          "relevance"
        ],
        "properties": {
          "receipt_path": {
            "type": "string",
            "pattern": "^\\$.+"
          },
          "value": {},
          "relevance": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "proposed_first_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "value",
        "receipt_path",
        "reason"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "project_action",
            "verification",
            "none"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "receipt_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
